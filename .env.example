# ---------------------------------------------------------------------------
# Phaatak — environment configuration
# Copy to .env and fill in. Nothing here is required to run the demo stack.
# ---------------------------------------------------------------------------

# --- application ---
ENVIRONMENT=development           # development | test | production
LOG_LEVEL=INFO
LOG_FORMAT=json                   # json | console
# Bare URL, comma-separated list, or JSON array — all accepted.
CORS_ORIGINS=http://localhost:3000

# --- database ---
# SQLite by default; switch to PostgreSQL without any code change:
# DATABASE_URL=postgresql+psycopg://phatak:phatak@db:5432/phatak
DATABASE_URL=sqlite+pysqlite:///./phatak.db
POSTGRES_PASSWORD=change-me

# --- cache ---
CACHE_BACKEND=memory              # memory | redis
# REDIS_URL=redis://cache:6379/0

# --- providers ---
# Free key at https://railradar.in/developers (100 requests/day once activated).
# Leave blank to run on the deterministic mock provider.
RAILRADAR_API_KEY=
GENERIC_REST_BASE_URL=
GENERIC_REST_API_KEY=

API_DAILY_REQUEST_BUDGET=100
API_LIVE_CALLS_PER_TICK=2

# --- scheduler ---
SCHEDULER_ENABLED=true
# Must stay below MAX_SIGHTING_AGE_SECONDS or every response is flagged stale.
INGEST_INTERVAL_SECONDS=2700
MAX_SIGHTING_AGE_SECONDS=4050

# --- pull-to-refresh ---
MANUAL_REFRESH_MIN_AGE_SECONDS=420

# --- security ---
# Required in production; admin endpoints fail closed without it.
ADMIN_API_KEY=

# --- frontend ---
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_CROSSING=siraspur
